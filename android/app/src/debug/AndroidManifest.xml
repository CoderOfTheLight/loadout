<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Debug builds only, and never shipped. The Dart VM service opens a
         local socket; without this permission it cannot bind, which takes
         hot reload, DevTools, and `flutter test integration_test` with it —
         the on-device proofs the release contract asks for become
         impossible to run.

         The shipped app's no-network guarantee is unaffected: `main` carries
         no INTERNET permission and CI dumps the permissions of the built
         RELEASE artifact to prove it. -->
    <uses-permission android:name="android.permission.INTERNET"/>
</manifest>
