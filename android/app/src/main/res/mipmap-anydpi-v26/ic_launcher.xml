<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (API 26+). The three layers are rendered from
     tool/icon/candidates/candidate_a_crate.dart by
     `fvm flutter test tool/icon/install_icons_test.dart`.

     The monochrome layer is not the foreground in one colour: flattened, the
     tote and its contents merge, so that layer re-cuts the boundaries the
     colours were carrying as transparent gaps. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
