<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Profile builds only, and never shipped — see the debug manifest.
         Profiling attaches over the Dart VM service, which needs a local
         socket. The release artifact carries no INTERNET permission and CI
         asserts that against the built APK. -->
    <uses-permission android:name="android.permission.INTERNET"/>
</manifest>
